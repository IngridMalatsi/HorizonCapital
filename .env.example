# Web-client Supabase configuration.
# Copy to web-client/.env; Vite exposes VITE_ values in the browser bundle.
# Use only a Supabase publishable key (or legacy anon key), never a secret/service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
