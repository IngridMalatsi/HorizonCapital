# Public browser configuration only. VITE_ values are embedded in the client.
# Never put Supabase secret/service-role keys or provider secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional API base URL including /api; defaults to same-origin /api.
# VITE_API_URL=https://api.example.com/api
