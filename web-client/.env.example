# ========================================================
# HorizonCapital — API Keys & Environment Configuration
# ========================================================
# Copy this file to 'web-client/.env' for local development.
# IMPORTANT: VITE_ variables are included in the browser bundle
# and are visible to every user. Never put service-role keys,
# private API keys, passwords, or other secrets in this file.
# Keep private provider credentials on a trusted backend.
# ========================================================

# 1. AI Engine (server-side only; do not place real secrets here)
# Recommended: Claude API (Anthropic) or Google Gemini API
# Code location: src/config/apiConfig.js -> callAiOrderParser()
VITE_AI_PROVIDER="anthropic" # Options: "anthropic", "gemini", "openai"
# Configure provider credentials on a trusted server, not in VITE_ variables.

# 2. Receipt OCR Engine (server-side only; do not place real secrets here)
# Recommended: Google Cloud Vision API, Mindee, or AWS Textract
# Code location: src/config/apiConfig.js -> callOcrReceiptScanner()
VITE_OCR_PROVIDER="google_vision" # Options: "google_vision", "mindee", "tesseract"
# Configure provider credentials on a trusted server, not in VITE_ variables.

# 3. Micro-POS & Payment Gateway (server-side only; do not place real secrets here)
# South African Providers: Yoco, Stitch Money, Ozow, Capitec Pay, Netcash
# Code location: src/config/apiConfig.js -> processSoftPosPayment()
VITE_PAYMENT_GATEWAY="stitch" # Options: "stitch", "yoco", "ozow", "capitec"
# Configure provider credentials on a trusted server, not in VITE_ variables.

# 4. Regulatory & Trust Registry (server-side only; do not place real secrets here)
# South African Government APIs or verification partners (e.g., SearchWorks, ThisIsMe)
# Code location: src/config/apiConfig.js -> verifyCipcBusiness()
# Configure provider credentials on a trusted server, not in VITE_ variables.

# 5. Supabase Auth and business profile
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key-here"

# Shared API (defaults to /api; Vite proxies it to http://127.0.0.1:4000)
# For a deployed web client, set this to the deployed API origin.
# VITE_API_URL="https://api.example.com/api"
