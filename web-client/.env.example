# ========================================================
# HorizonCapital — API Keys & Environment Configuration
# ========================================================
# Copy this file to '.env' in the project root and populate
# your production API keys when deploying live services.
# In development without keys, HorizonCapital automatically
# uses high-fidelity local simulators.
# ========================================================

# 1. AI Engine (WhatsApp Order Parsing & Scam Detection)
# Recommended: Claude API (Anthropic) or Google Gemini API
# Code location: src/config/apiConfig.js -> callAiOrderParser()
VITE_AI_PROVIDER="anthropic" # Options: "anthropic", "gemini", "openai"
VITE_ANTHROPIC_API_KEY="your-anthropic-api-key-here"
VITE_GEMINI_API_KEY="your-gemini-api-key-here"

# 2. Receipt OCR Engine (Snap-to-Record Physical Invoices)
# Recommended: Google Cloud Vision API, Mindee, or AWS Textract
# Code location: src/config/apiConfig.js -> callOcrReceiptScanner()
VITE_OCR_PROVIDER="google_vision" # Options: "google_vision", "mindee", "tesseract"
VITE_VISION_OCR_API_KEY="your-vision-api-key-here"

# 3. Micro-POS & Payment Gateway (Tap-to-Pay / EFT)
# South African Providers: Yoco, Stitch Money, Ozow, Capitec Pay, Netcash
# Code location: src/config/apiConfig.js -> processSoftPosPayment()
VITE_PAYMENT_GATEWAY="stitch" # Options: "stitch", "yoco", "ozow", "capitec"
VITE_PAYMENT_API_KEY="your-payment-gateway-key-here"
VITE_PAYMENT_MERCHANT_ID="your-merchant-id-here"

# 4. Regulatory & Trust Registry (CIPC & SARS Tax Verification)
# South African Government APIs or verification partners (e.g., SearchWorks, ThisIsMe)
# Code location: src/config/apiConfig.js -> verifyCipcBusiness()
VITE_CIPC_VERIFICATION_KEY="your-cipc-sars-verification-key-here"

# 5. Database & Cloud Sync (Transactional Ledger & Profiles)
# Recommended: Supabase (PostgreSQL) or Firebase Firestore
# Code location: src/config/apiConfig.js -> supabaseClient
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
